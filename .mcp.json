{
  "mcpServers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./docs"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "expenses": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "mcp-server",
        "server.py"
      ],
      "env": {
        "EXPENSE_API_URL": "http://localhost:8000"
      }
    }
  }
}
